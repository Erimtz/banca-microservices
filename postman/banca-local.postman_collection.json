        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Mendoza\",\n  \"email\": \"carlos.mendoza@ejemplo.com\",\n  \"documento\": \"1098123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrlCliente}}/api/clientes",
              "host": [
                "{{baseUrlCliente}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\u0027Creado 201\u0027, function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\u0027Devuelve el id asignado\u0027, function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\u0027id\u0027);",
                  "pm.collectionVariables.set(\u0027clienteIdCreado\u0027, body.id);",
                  "try { pm.environment.set(\u0027clienteIdCreado\u0027, body.id); } catch (e) {}",
                  "});",
                  "pm.test(\u0027Location apunta al recurso\u0027, function () {",
                  "    pm.response.to.have.header(\u0027Location\u0027);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar cliente creado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Mendoza Actualizado\",\n  \"email\": \"carlos.mendoza@ejemplo.com\",\n  \"documento\": \"1098123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrlCliente}}/api/clientes/{{clienteIdCreado}}",
              "host": [
                "{{baseUrlCliente}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteIdCreado}}"
              ]
            },
            "description": "Usa el id que guardó la petición \"Crear cliente\". Ejecuta esa primero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\u0027Actualizado 200\u0027, function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().nombre).to.eql(\u0027Carlos Mendoza Actualizado\u0027);",
                  "});"
                ]
              }
            },
            {
              "script": {
                "exec": [
                  "// PUT/DELETE necesita un id valido. Se crea el recurso si la variable",
                  "// esta vacia o si el id ya no existe (p. ej. tras reiniciar los contenedores).",
                  "var base = pm.collectionVariables.get(\u0027baseUrlCliente\u0027) || pm.environment.get(\u0027baseUrlCliente\u0027);",
                  "var id = pm.collectionVariables.get(\u0027clienteIdCreado\u0027) || pm.environment.get(\u0027clienteIdCreado\u0027);",
                  "",
                  "function guardar(nuevoId) {",
                  "    if (!nuevoId) { return; }",
                  "    pm.collectionVariables.set(\u0027clienteIdCreado\u0027, nuevoId);",
                  "    try { pm.environment.set(\u0027clienteIdCreado\u0027, nuevoId); } catch (e) {}",
                  "}",
                  "",
                  "function crear() {",
                  "    pm.sendRequest({",
                  "        url: base + \u0027/api/clientes\u0027,",
                  "        method: \u0027POST\u0027,",
                  "        header: { \u0027Content-Type\u0027: \u0027application/json\u0027 },",
                  "        body: { mode: \u0027raw\u0027, raw: JSON.stringify({ nombre: \u0027Cliente Postman\u0027, email: \u0027postman@ejemplo.com\u0027, documento: \u0027999888777\u0027 }) }",
                  "    }, function (err, res) {",
                  "        if (!err \u0026\u0026 res.code === 201) { guardar(res.json().id); }",
                  "    });",
                  "}",
                  "",
                  "if (!id) {",
                  "    crear();",
                  "} else {",
                  "    pm.sendRequest({ url: base + \u0027/api/clientes/\u0027 + id, method: \u0027GET\u0027 }, function (err, res) {",
                  "        if (err || res.code !== 200) { crear(); }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              },
              "listen": "prerequest"
            }
          ]
        },
