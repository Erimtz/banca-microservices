        {
          "name": "3. Sentido A: cliente-service llama a cuenta-service",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlCliente}}/api/clientes/1/cuentas",
              "host": [
                "{{baseUrlCliente}}"
              ],
              "path": [
                "api",
                "clientes",
                "1",
                "cuentas"
              ]
            },
            "description": "El cliente-service llama por HTTP a `http://cuenta-service:8082/api/cuentas/cliente/1` y compone la respuesta con sus datos locales.\n\nVerifica la petición cruzada con:\n`docker compose logs cliente-service`"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\u0027Respuesta compuesta 200\u0027, function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\u0027cliente local + cuentas remotas\u0027, function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.cliente.id).to.eql(1);",
                  "    pm.expect(body.cliente.nombre).to.be.a(\u0027string\u0027);",
                  "    pm.expect(body.cuentas.length).to.be.above(0);",
                  "    pm.expect(body.cuentas[0]).to.have.property(\u0027numero\u0027);",
                  "    pm.expect(body.cuentas[0]).to.have.property(\u0027saldo\u0027);",
                  "    pm.expect(body.cuentas[0].clienteId).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
