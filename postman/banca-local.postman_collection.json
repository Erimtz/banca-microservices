        {
          "name": "Actualizar cuenta creada",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"4750555000\",\n  \"tipo\": \"CORRIENTE\",\n  \"saldo\": 3000000.00,\n  \"clienteId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrlCuenta}}/api/cuentas/{{cuentaIdCreada}}",
              "host": [
                "{{baseUrlCuenta}}"
              ],
              "path": [
                "api",
                "cuentas",
                "{{cuentaIdCreada}}"
              ]
            },
            "description": "Usa el id que guardó la petición \"Crear cuenta\". Ejecuta esa primero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\u0027Actualizada 200\u0027, function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().tipo).to.eql(\u0027CORRIENTE\u0027);",
                  "});"
                ]
              }
            },
            {
              "script": {
                "exec": [
                  "// PUT/DELETE necesita un id valido. Se crea el recurso si la variable",
                  "// esta vacia o si el id ya no existe (p. ej. tras reiniciar los contenedores).",
                  "var base = pm.collectionVariables.get(\u0027baseUrlCuenta\u0027) || pm.environment.get(\u0027baseUrlCuenta\u0027);",
                  "var id = pm.collectionVariables.get(\u0027cuentaIdCreada\u0027) || pm.environment.get(\u0027cuentaIdCreada\u0027);",
                  "",
                  "function guardar(nuevoId) {",
                  "    if (!nuevoId) { return; }",
                  "    pm.collectionVariables.set(\u0027cuentaIdCreada\u0027, nuevoId);",
                  "    try { pm.environment.set(\u0027cuentaIdCreada\u0027, nuevoId); } catch (e) {}",
                  "}",
                  "",
                  "function crear() {",
                  "    pm.sendRequest({",
                  "        url: base + \u0027/api/cuentas\u0027,",
                  "        method: \u0027POST\u0027,",
                  "        header: { \u0027Content-Type\u0027: \u0027application/json\u0027 },",
                  "        body: { mode: \u0027raw\u0027, raw: JSON.stringify({ numero: \u00274750000009\u0027, tipo: \u0027AHORRO\u0027, saldo: 100000, clienteId: 1 }) }",
                  "    }, function (err, res) {",
                  "        if (!err \u0026\u0026 res.code === 201) { guardar(res.json().id); }",
                  "    });",
                  "}",
                  "",
                  "if (!id) {",
                  "    crear();",
                  "} else {",
                  "    pm.sendRequest({ url: base + \u0027/api/cuentas/\u0027 + id, method: \u0027GET\u0027 }, function (err, res) {",
                  "        if (err || res.code !== 200) { crear(); }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              },
              "listen": "prerequest"
            }
          ]
        },
