                  "    try { pm.environment.set(\u0027clienteIdCreado\u0027, nuevoId); } catch (e) {}",
                  "}",
                  "",
                  "function crear() {",
                  "    pm.sendRequest({",
                  "        url: base + \u0027/api/clientes\u0027,",
                  "        method: \u0027POST\u0027,",
                  "        header: { \u0027Content-Type\u0027: \u0027application/json\u0027 },",
                  "        body: { mode: \u0027raw\u0027, raw: JSON.stringify({ nombre: \u0027Cliente Postman\u0027, email: \u0027postman@ejemplo.com\u0027, documento: \u0027999888777\u0027 }) }",
                  "    }, function (err, res) {",
                  "        if (!err \u0026\u0026 res.code === 201) { guardar(res.json().id); }",
                  "    });",
                  "}",
                  "",
                  "if (!id) {",
                  "    crear();",
                  "} else {",
                  "    pm.sendRequest({ url: base + \u0027/api/clientes/\u0027 + id, method: \u0027GET\u0027 }, function (err, res) {",
                  "        if (err || res.code !== 200) { crear(); }",
                  "    });",
