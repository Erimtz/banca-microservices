            {
              "script": {
                "exec": [
                  "// PUT/DELETE necesita un id valido. Se crea el recurso si la variable",
                  "// esta vacia o si el id ya no existe (p. ej. tras reiniciar los contenedores).",
                  "var base = pm.collectionVariables.get(\u0027baseUrlCliente\u0027) || pm.environment.get(\u0027baseUrlCliente\u0027);",
                  "var id = pm.collectionVariables.get(\u0027clienteIdCreado\u0027) || pm.environment.get(\u0027clienteIdCreado\u0027);",
                  "",
                  "function guardar(nuevoId) {",
