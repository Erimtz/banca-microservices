# ============================================================================
# Variables de entorno del proyecto — copia este archivo a .env y edítalo:
#
#     cp .env.example .env
#
# docker compose lee .env automáticamente al levantar los contenedores.
# Este archivo (.env.example) SÍ se sube al repositorio; .env NO (está en
# .gitignore) porque ahí sí van los valores reales de tu entorno.
# ============================================================================

# --- cliente-service (puerto 8081) -------------------------------------------
# URL del cuenta-service tal como la ve el cliente-service dentro de la red
# de Docker (nombre del servicio + puerto).
SERVICIO_CUENTAS_BASE_URL=http://cuenta-service:8082
# Timeout (ms) de las llamadas salientes al cuenta-service.
SERVICIO_CUENTAS_TIMEOUT_MS=3000
# Nombre que aparece en los logs del cliente-service.
SERVICIO_NOMBRE_CLIENTE=cliente-service

# --- cuenta-service (puerto 8082) --------------------------------------------
# URL del cliente-service tal como la ve el cuenta-service dentro de la red.
SERVICIO_CLIENTES_BASE_URL=http://cliente-service:8081
# Timeout (ms) de las llamadas salientes al cliente-service.
SERVICIO_CLIENTES_TIMEOUT_MS=3000
# Nombre que aparece en los logs del cuenta-service.
SERVICIO_NOMBRE_CUENTA=cuenta-service

# --- Persistencia del cuenta-service (H2 en modo archivo) --------------------
# Archivo H2 dentro del contenedor; lo conserva el volumen 'cuenta-data'.
# Si defines una ruta distinta, apúntala a /app/data/... para que el volumen
# cubra el archivo.
CUENTA_DB_URL=jdbc:h2:file:/app/data/cuentas
# Usuario H2 por defecto. La BD no expone ningún puerto: solo es accesible
# desde dentro del contenedor, no hace falta contraseña.
CUENTA_DB_USER=sa
CUENTA_DB_PASSWORD=
